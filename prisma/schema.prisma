generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id           Int          @id @default(autoincrement())
  name         String?
  username     String?
  email        String       @unique
  passwordHash String?
  role         Role         @default(USER)
  createdAt    DateTime     @default(now())
  portfolios   Portfolio[]
  watchlists   Watchlist[]
  bookmarks    Bookmark[]
  pageVisits   PageVisit[]
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]

  @@map("users")
}

model Portfolio {
  id            Int           @id @default(autoincrement())
  userId        Int
  portfolioName String        @map("portfolio_name")
  baseCurrency  String        @default("USD") @map("base_currency")
  cashBalance   Float         @default(100000) @map("cash_balance")
  sgdBalance    Float         @default(0) @map("sgd_balance")
  eurBalance    Float         @default(0) @map("eur_balance")
  createdAt     DateTime      @default(now()) @map("created_at")
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions  Transaction[]
  holdings      Holding[]
  cashActivities CashActivity[]

  @@map("portfolios")
}

model Transaction {
  id              Int       @id @default(autoincrement())
  portfolioId     Int       @map("portfolio_id")
  tickerSymbol    String    @map("ticker_symbol")
  transactionType String    @map("transaction_type")
  quantity        Float
  price           Float
  fees            Float     @default(0)
  transactionDate DateTime  @default(now()) @map("transaction_date")
  portfolio       Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@map("transactions")
}

model Holding {
  id           Int       @id @default(autoincrement())
  portfolioId  Int       @map("portfolio_id")
  tickerSymbol String    @map("ticker_symbol")
  quantity     Float
  averageCost  Float     @map("average_cost")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  portfolio    Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@map("holdings")
}

model Watchlist {
  id            Int              @id @default(autoincrement())
  userId        Int              @map("user_id")
  watchlistName String           @map("watchlist_name")
  createdAt     DateTime         @default(now()) @map("created_at")
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  stocks        WatchlistStock[]

  @@map("watchlists")
}

model WatchlistStock {
  id           Int       @id @default(autoincrement())
  watchlistId  Int       @map("watchlist_id")
  tickerSymbol String    @map("ticker_symbol")
  addedAt      DateTime  @default(now()) @map("added_at")
  watchlist    Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)

  @@map("watchlist_stocks")
}

model EducationalContent {
  id              Int        @id @default(autoincrement())
  topic           String
  title           String
  content         String
  difficultyLevel String?    @map("difficulty_level")
  createdAt       DateTime   @default(now()) @map("created_at")
  bookmarks       Bookmark[]

  @@map("educational_content")
}

model StockCache {
  tickerSymbol String   @id @map("ticker_symbol")
  data         Json
  cachedAt     DateTime @default(now()) @map("cached_at")

  @@map("stock_cache")
}

model Bookmark {
  id        Int                @id @default(autoincrement())
  userId    Int                @map("user_id")
  articleId Int                @map("article_id")
  createdAt DateTime           @default(now()) @map("created_at")
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  article   EducationalContent @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@map("bookmarks")
}

model PageVisit {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  page      String
  visitedAt DateTime @default(now()) @map("visited_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("page_visits")
}

model Account {
  id                String  @id @default(cuid())
  userId            Int
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       Int
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String   @unique
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())
}

model CashActivity {
  id              Int       @id @default(autoincrement())
  portfolioId     Int       @map("portfolio_id")
  activityType    String    @map("activity_type")
  currency        String?
  amount          Float
  fromCurrency    String?   @map("from_currency")
  toCurrency      String?   @map("to_currency")
  convertedAmount Float?    @map("converted_amount")
  exchangeRate    Float?    @map("exchange_rate")
  createdAt       DateTime  @default(now()) @map("created_at")
  portfolio       Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId, createdAt])
  @@map("cash_activities")
}
